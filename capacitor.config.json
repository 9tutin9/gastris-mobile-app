{
  "appId": "cz.gastris.app",
  "appName": "GastrIS",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true
  },
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.ts.net",
      "*.*.ts.net",
      "*.*.*.ts.net",
      "100.*.*.*",
      "192.168.*.*",
      "10.*.*.*",
      "172.16.*.*"
    ]
  }
}
